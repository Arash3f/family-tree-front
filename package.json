{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "prepare": "husky",
    "cz": "git commit",
    "dev": "next dev --port 5173",
    "build": "next build",
    "start": "next start --port 5173",
    "lint": "eslint",
    "test": "node --import ./scripts/test-alias-hook.mjs --test \"src/**/*.test.mts\"",
    "test:export": "node scripts/export-e2e.mjs",
    "test:layout": "node scripts/check-layout.mjs",
    "shots": "node scripts/shoot-landing.mjs",
    "bench:layout": "node --import ./scripts/test-alias-hook.mjs scripts/bench-layout.mjs"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.2",
    "html-to-image": "1.11.11",
    "next": "16.3.0",
    "next-intl": "^4.13.5",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-date-object": "^2.1.9",
    "react-dom": "19.2.8",
    "react-icons": "^5.7.0",
    "react-multi-date-picker": "^4.5.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "commitizen": "^4.3.1",
    "commitlint-config-gitmoji": "^2.3.1",
    "cz-customizable": "^7.5.4",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "playwright": "^1.62.1",
    "typescript": "^5"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-customizable"
    },
    "cz-customizable": {
      "config": ".cz-config.js"
    }
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ]
  }
}
