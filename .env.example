# Upstream API for the /backend proxy (server-side only).
API_PROXY_TARGET=https://family-api.arash-alfooneh.ir

# Absolute site origin for metadataBase, sitemap, robots, Open Graph.
# NEXT_PUBLIC_SITE_URL=https://your-frontend.example.com

# Keep browser calls same-origin via /backend (default). Uncomment only if you
# intentionally want the client to talk to the API cross-origin:
# NEXT_PUBLIC_API_BASE_URL=https://family-api.arash-alfooneh.ir
